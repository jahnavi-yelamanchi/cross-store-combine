# Copy to terraform.tfvars and adjust. Credentials come from the AWS SDK chain
# (env vars, SSO, instance role), never from this file.
region      = "us-east-1"
project     = "xstore"
environment = "dev"
azs         = ["us-east-1a", "us-east-1b", "us-east-1c"]
vpc_cidr    = "10.40.0.0/16"

deletion_protection = false
create_ledger_table = false

# Layer with fastavro, pydantic, pyyaml for the CDC Lambda:
#   pip install --target build/python fastavro pydantic pyyaml
#   (cd build && zip -r ../deps.zip python) && aws lambda publish-layer-version ...
lambda_layer_arns = []

# Upload the Debezium Postgres plugin zip to the lake bucket first.
enable_debezium_connectors = false
debezium_plugin_s3_key     = "plugins/debezium-connector-postgres.zip"

enable_eks          = false
eks_version         = "1.31"
eks_public_endpoint = false
