# Langfuse credentials for agent tiebreak generations (xstore.observability.langfuse_hook).
# Copy into the repo-root .env (gitignored) and fill in; all three must be set or the hook is a no-op.
# Compose: `env_file: .env` on the xstore service.
# Self-hosted Langfuse in the same compose network: LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Optional
XSTORE_ENV=
LANGFUSE_SAMPLE_RATE=
LANGFUSE_TRACING_ENABLED=
