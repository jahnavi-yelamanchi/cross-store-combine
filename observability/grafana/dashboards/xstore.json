          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(xstore_cdc_event_to_proposal_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(xstore_cdc_event_to_proposal_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
