          "expr": "histogram_quantile(0.95, sum by (le) (rate(xstore_tiebreak_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
